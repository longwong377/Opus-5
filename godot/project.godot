; Babylon 5 station simulation.
; Engine must be the double-precision build -- see docs/adr/0001-engine-choice.md
; and station/physics/floating_origin.py for why.

config_version=5

[application]
config/name="Babylon 5"
config/description="1:1 simulation of the Babylon 5 station. 8,047 m."
; The default scene. tools/render_godot.sh passes an explicit scene path as a
; positional argument, so this only decides what a bare `godot --path godot`
; opens; every shot names its own scene through station/generated/scene/*/scene.json.
run/main_scene="res://scenes/exterior.tscn"
config/features=PackedStringArray("4.4", "Double Precision", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]
renderer/rendering_method="forward_plus"
; Far plane must clear the whole station plus flight range. Double precision is
; what makes a depth range this large usable without z-fighting.
camera/depth_of_field/depth_of_field_bokeh_shape=1
lights_and_shadows/directional_shadow/size=4096
; Omni and spot shadows are cube maps -- six renders each -- and the drum runs
; a hundred-plus omnis off the light runs. Only a handful cast, so the map can
; stay small without the frame paying for it.
lights_and_shadows/positional_shadow/atlas_size=2048
; 4x MSAA. The drum is full of one-metre truss members seen at a kilometre, and
; without multisampling they alias into a shimmering mesh that reads as noise
; rather than as structure. It is the single most valuable quality setting for
; this subject and it costs a CPU rasteriser less than the screen-space passes.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
; Everything is triplanar (the glTF export carries POSITION and NORMAL only),
; so anisotropy is doing real work on ground planes seen at grazing angles.
textures/default_filters/anisotropic_filtering_level=3

[physics]
; The station is 8 km long and the flight envelope is 50 km. Godot's defaults
; assume a room.
3d/default_gravity=0.0
