[sub_resource type="Environment" id="Env"]
; Flat colour, not a sky. Near-black rather than pure black for the reason the
; drum scene gives: pure black let two structural holes survive four sessions
; of renders, because a hole and an unlit surface were the same pixels. A faint
; cool grey means an actual hole reads as slightly wrong instead of as shadow.
background_mode = 1
background_color = Color(0.010, 0.012, 0.018, 1)
ambient_light_source = 2
ambient_light_color = Color(0.52, 0.55, 0.62, 1)
; 0.015, a tenth of the drum's 0.15. See decision 2 above.
ambient_light_energy = 1.30
reflected_light_source = 1
tonemap_mode = 4
tonemap_exposure = 1.0
; White point 4.0 against the drum's 8.0: nothing in a corridor is as bright as
; a sun-tube, and an 8.0 white point rolls the fittings off to grey.
tonemap_white = 4.0
ssao_enabled = true
ssao_radius = 0.6
ssao_intensity = 2.2
ssao_power = 1.5
ssao_light_affect = 0.15
glow_enabled = true
; The fittings are small and bright and the room is dark, which is exactly the
; case glow is for. Kept low: a corridor lit by haloes is a music video.
glow_intensity = 0.55
glow_strength = 0.9
glow_bloom = 0.05
glow_hdr_threshold = 1.1
glow_blend_mode = 1

; --- SESSION 4e: the three things that were missing, and why they dominate ---
; The A/B in docs/engine-4e-pilaster-ab.png put eight new texture sheets onto
; 131 previously untextured materials and the frame stayed FLAT. That is the
; measurement that says the bottleneck is not material: this Environment
; carried SSAO and glow and nothing else, so every shadowed surface in the
; station was lit by a single flat ambient term and rendered as dead grey.
;
;;; MEASURED, AND THE FIRST MEASUREMENT WAS WRONG. Session 4e first recorded
;;; SSIL and the volumetric fog below as BYTE-IDENTICAL on/off and concluded
;;; "Mesa lavapipe does not run them". The renderer was not lavapipe. The
;;; container had no Vulkan ICD at all, so Godot fell back to OpenGL 3
;;; Compatibility -- which has no Forward+ and therefore none of SSAO, glow,
;;; SSIL, fog or adjustment -- and exited 0 with a flat grey PNG. The features
;;; were not being skipped; the pipeline they belong to was never running.
;;;
;;; Re-measured on Vulkan 1.4.318 - Forward+, same camera, same lights:
;;;
;;;     ssil_enabled           on vs off -> 86.0% of pixels differ, mean 8.9/255
;;;     volumetric_fog_enabled on vs off -> 40.1% of pixels differ, mean 1.4/255
;;;
;;; Both are doing a great deal, and SSIL is the largest single contributor in
;;; this scene. `tools/render_godot.sh` now refuses to run without an ICD and
;;; deletes the PNG if Godot reports the fallback, so a frame cannot lie about
;;; which renderer made it again.
;
; SSIL -- screen-space indirect light. SSAO only DARKENS creases; nothing in
; this scene ever put bounced light back into them. A corridor is a white-ish
; tube with 725 spot sources in it and almost all of its light should be
; second-bounce.
ssil_enabled = true
; 3 m: a corridor is 2.6 m across the clear width, so the radius has to reach
; the opposite wall or the bounce is confined to the crease it started in.
ssil_radius = 3.0
ssil_intensity = 0.9
ssil_sharpness = 0.98
ssil_normal_rejection = 1.0

; VOLUMETRIC FOG. 40.1% of pixels, measured -- see above. This is what makes
; 725 spot sources read as light in air
; instead of as bright patches on a wall. Density is deliberately low: a
; pressurised habitat is clean air, and a shaft should be perceptible rather
; than smoky. Note that shafts additionally need SHADOW-CASTING lights and this
; deck has 2 of 1557, so even on a GPU this would give haze and not beams until
; that changes.
volumetric_fog_enabled = true
volumetric_fog_density = 0.014
volumetric_fog_albedo = Color(0.78, 0.81, 0.88, 1)
volumetric_fog_emission = Color(0, 0, 0, 1)
volumetric_fog_emission_energy = 0.0
; GI injection is what lets the fog pick up the room's own bounce rather than
; only its direct sources, so the shafts sit in a lit volume instead of hanging
; in black.
volumetric_fog_gi_inject = 0.7
; Forward scatter: a shaft brightens when you look towards its source, which is
; the whole reason a beam reads as a beam.
volumetric_fog_anisotropy = 0.35
volumetric_fog_length = 72.0
volumetric_fog_detail_spread = 2.0
volumetric_fog_ambient_inject = 0.25
volumetric_fog_sky_affect = 0.0

; GRADING. The frame measures almost perfectly neutral, which is why it reads
; as a greybox even where the materials are correct: the warm fittings and the
; cool ambient are both present and neither is allowed to say so. Saturation is
; the term that matters; contrast is nudged rather than pushed because layer
; 4b's distribution gate is measured on these frames.
adjustment_enabled = true
adjustment_brightness = 1.0
; 1.00, NOT 1.06. Contrast pivots about mid grey, so on a frame whose median
; luminance is 0.05 it does almost nothing to the highlights and crushes the
; shadows: measured, 1.06 took p5 from 0.0089 to 0.0056 and the crushed
; fraction from 2.2% to 3.2%. This frame does not need more contrast, it needs
; more light in the dark half, and that is a lighting change rather than a
; grading one.
adjustment_contrast = 1.0
adjustment_saturation = 1.22

