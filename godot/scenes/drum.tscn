[sub_resource type="Environment" id="Env"]
; Flat colour, not a sky: from inside the drum there is nothing beyond the
; geometry, so anything the background shows is a hole. Near-black rather than
; pure black on purpose -- pure black is what let two structural holes survive
; four sessions of renders, because a hole and an unlit surface were the same
; pixels. A faint blue-grey means an actual hole reads as slightly wrong
; instead of as shadow.
background_mode = 1
background_color = Color(0.012, 0.016, 0.024, 1)
ambient_light_source = 2
ambient_light_color = Color(0.55, 0.56, 0.52, 1)
ambient_light_energy = 0.15
reflected_light_source = 1
tonemap_mode = 4
tonemap_exposure = 1.0
tonemap_white = 8.0
ssao_enabled = true
; 2.5 m: human scale. The exterior scene uses 14 m because its subject is
; 8 km long; the same number here would smear contact shadows across a field.
ssao_radius = 2.5
ssao_intensity = 1.8
ssao_power = 1.5
ssao_light_affect = 0.2
ssao_detail = 0.6
; Retuned by looking, and by rendering once with the light runs switched off
; to see which term was responsible. At 0.00035 the fog alone -- with every
; light in the drum dark -- still washed the far half of the volume to a pale
; grey. Half the pixel at the far end cap was fog colour, so material,
; contrast and the end cap's own modelling were all being painted over by
; atmosphere. 0.00012 leaves ~80% transmission at the 1.9 km end cap, which
; still separates near from far without becoming the subject.
fog_enabled = true
fog_mode = 0
fog_light_color = Color(0.42, 0.45, 0.47, 1)
fog_light_energy = 0.8
fog_density = 0.00012
fog_aerial_perspective = 0.0
fog_sky_affect = 0.0
glow_enabled = true
glow_normalized = true
glow_intensity = 0.7
glow_strength = 1.05
glow_bloom = 0.06
glow_blend_mode = 1
glow_hdr_threshold = 0.95

[node name="DrumShot" type="Node3D"]
script = ExtResource("1")
; Inside the drum nothing should reach the fallback -- export_scene.py's
; self-test asserts every emitted group has a rule -- so the fallback exists
; only to make a failure of that assertion unmissable in the frame. It is
; magenta: this project has twice lost a session to a defect that was
; invisible because the wrong thing and the background were the same pixels.
fallback_material = ExtResource("m_unbound")
warmup_frames = 8
light_gain = 1.0
material_rules = {
"bay_lip": ExtResource("m_hazard_chevron"),
"core_hub_": ExtResource("m_core_dark"),
"core_hub_lamp": ExtResource("m_lamp_small"),
"core_node_": ExtResource("m_core_dark"),
