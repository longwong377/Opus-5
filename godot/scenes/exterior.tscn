[gd_scene load_steps=22 format=3]

; The station against space.
;
; Geometry is loaded at runtime from the .glb tools/export_scene.py writes, so
; nothing about the hull is in this file. What IS in this file is everything
; that is a judgement: the environment, the tonemapper, and the three lights.
;
; Lighting is a three-point set-up, which is what every VFX house that ever
; photographed a spaceship model used and what the show's own miniature work
; used. In vacuum the sun is the only physical source; a fill and a rim are
; there because the alternative is half the station in absolute black, and
; absolute black hides both the silhouette and any modelling error inside it.
; They are extrapolation and are declared as such -- see the return value's
; extrapolation list.

[ext_resource type="Script" path="res://scripts/render_shot.gd" id="1"]
[ext_resource type="Shader" path="res://scenes/space_sky.gdshader" id="2"]
[ext_resource type="Material" path="res://materials/hull_exterior.tres" id="m_hull"]
[ext_resource type="Material" path="res://materials/structural_truss.tres" id="m_truss"]
[ext_resource type="Material" path="res://materials/radiator.tres" id="m_rad"]
[ext_resource type="Material" path="res://materials/cargo_module.tres" id="m_cargo"]
[ext_resource type="Material" path="res://materials/marker_light_white.tres" id="m_navlight"]
[ext_resource type="Material" path="res://materials/marker_light_red.tres" id="m_hazlight"]
[ext_resource type="Material" path="res://materials/swept_array.tres" id="m_panel"]
[ext_resource type="Material" path="res://materials/hull_banding_red.tres" id="m_band"]
[ext_resource type="Material" path="res://materials/greeble_fitting.tres" id="m_greeble_fitting"]
[ext_resource type="Material" path="res://materials/habitat_windows.tres" id="m_habitat_windows"]
[ext_resource type="Material" path="res://materials/hazard_chevron.tres" id="m_hazard_chevron"]
[ext_resource type="Material" path="res://materials/bay_frame.tres" id="m_bay_frame"]
[ext_resource type="Material" path="res://materials/bay_well.tres" id="m_bay_well"]
[ext_resource type="Material" path="res://materials/dome_glazing.tres" id="m_dome_glazing"]
[ext_resource type="Material" path="res://materials/dome_structure.tres" id="m_dome_structure"]

[sub_resource type="ShaderMaterial" id="SkyMat"]
shader = ExtResource("2")
shader_parameter/star_gain = 2.6
shader_parameter/bright_density = 0.022
shader_parameter/faint_density = 0.055

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")
; 128 is plenty: the radiance map of a starfield is nearly uniform black, and
; anything larger is a cubemap convolution this CPU renderer pays for every
; run for no visible return.
radiance_size = 2
process_mode = 1

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
; Ambient stands for light the station receives that is not the sun: Epsilon
; III below it and the rest of the sky. Kept dim and slightly blue so that
; unlit faces read as dark rather than as holes. It is a judgement, not a
; measurement.
;
; Tuned down from 0.5 by looking: at 0.5, with the fill and rim on top, a key
; 70 degrees off the camera axis produced no visible terminator on a cylinder
; 8 km long -- the station read as one flat grey value end to end. Vacuum has
; almost no ambient, and the render was proving it by being wrong.
ambient_light_source = 2
ambient_light_color = Color(0.14, 0.16, 0.22, 1)
ambient_light_energy = 0.22
reflected_light_source = 2
; AgX rather than ACES. ACES pushes bright warm highlights toward orange, and
; the hull has a lot of near-white sunlit plate; AgX keeps the hue and rolls
; off later, which is what stops a sunlit 8 km hull from reading as a flat
; white shape with detail only in the shadows.
tonemap_mode = 4
; THE DAY EXPOSURE, and until now the exterior was the one lit volume in the
; project with no measured one. Obtained the way every room's is: render a
; fixed shot, measure it and its reference frame with tools/measure_frame.py,
; scale until it sits at the x1.40 of its reference the corridor sits at.
; The derivation, the calibration shot and the crop boxes are in
; tools/export_scene.EXTERIOR_CALIBRATION; the short version:
;
;   reference/01-station-exterior/exterior more.jpg, habitat drum, the
;   BRIGHTEST SUNLIT PLATE (p95): side view 0.2378, top view 0.2051, mean
;   0.2215. At exposure 1.00 our matched side-on frame read 0.5117 -- x2.31 of
;   the reference. AgX is strongly sub-linear here (three points: 1.00 -> .512,
;   0.70 -> .425, 0.40 -> .294, i.e. out ~ exposure^0.62), so the correction is
;   not the ratio. 0.43 lands it at 0.3108 = x1.403.
;
; MEASURED ON p95, NOT ON THE MEDIAN, and that is the one departure from the
; interior procedure. The reference hull is mostly DARK -- broad blue-purple
; courses between silver ones, mean linear rgb (0.086, 0.086, 0.111) -- and
; ours is warm off-white throughout at (0.395, 0.350, 0.312). Its median sits
; at 29% of its brightest plate and ours at 76%. No exposure fixes a shape
; difference: matching the median instead would put our sunlit plating at HALF
; the show's and would have to be undone the moment the hull material gains its
; banding. p95 is the brightest plate in both frames and is the same white
; plating in both, so it is the statistic the missing banding does not corrupt.
; The residual is a LAYER-3 finding against the hull material and is recorded
; as one, not tuned away here.
tonemap_exposure = 0.43
tonemap_white = 6.0
ssao_enabled = true
ssao_radius = 14.0
ssao_intensity = 1.6
ssao_power = 1.4
ssao_light_affect = 0.15
glow_enabled = true
glow_normalized = true
glow_intensity = 0.55
glow_strength = 1.0
glow_bloom = 0.03
glow_blend_mode = 1
glow_hdr_threshold = 1.1

; ---------------------------------------------------------------------------
; THE NIGHT SIDE
; ---------------------------------------------------------------------------
; The standing blocking finding this closes, recorded in session 3k: "The
; lighting rig has no night side... the owner's opening beat is the station
; coming into view, so that shot cannot be composed until the rig changes."
;
; A SECOND ENVIRONMENT RATHER THAN A SECOND SCENE. The look has to be judged as
; a whole, which argues for a whole scene file -- but exterior.tscn's
; `material_rules` block is generated by `station/materials.py --export`, and a
; copied scene would stop matching the material library the first time a
; material was added, silently, with the difference invisible in a render.
; Everything that differs between the two conditions is here, side by side,
; readable in one file: exposure, ambient, bloom, and (on the root node)
; which lights go dark.
;
; SAME FILM, DIFFERENT STOP. tonemap_mode and tonemap_white are deliberately
; identical to the day environment. If the two conditions used different
; curves, nothing measured under one would say anything about the other, and
; the terminator -- which spans both -- would be graded twice.
[sub_resource type="Environment" id="EnvNight"]
background_mode = 2
sky = SubResource("Sky")
; PLANETSHINE, and it is the only non-sun source there is. The station holds
; station over Epsilon III, which fills a large solid angle beneath it, so the
; unlit hull is lit by a planet rather than by nothing. Warm-neutral rather
; than the day environment's blue, because that blue stood for "the rest of the
; sky" and at night the sky contributes nothing measurable.
;
; The ENERGY IS A TRADE, and it is the only real judgement in this file.
; Planetshine buys the SILHOUETTE and it is paid for out of the WINDOWS, and
; the two are measured against each other at the arrival framing:
;
;   energy  station footprint visible   habitat / unlit structure
;           against the starfield       (12.7 in daylight)
;   0.00              37.9%                    unbounded
;   0.12              66.8%                        30.4
;   0.55              94.6%                        14.4  <- daylight's ratio
;
; At 0 the truss and the reactor end are indistinguishable from space and the
; station reads as two blocks rather than as an 8 km object. At 0.55 the whole
; hull reads -- and the pressurised sections are no more distinct from the
; unlit ones than they are in full sun, which is the finding thrown away.
; 0.12 also happens to put the unlit habitat hull at 0.0112, just over
; tools/measure_frame.py's 0.010 measurable floor: the dimmest value that is
; still a value.
;
; DECLARED, authority 5. No frame in the reference set shows this hull at range
; on the anti-sun side. What would overturn it: one.
ambient_light_source = 2
ambient_light_color = Color(0.30, 0.27, 0.24, 1)
ambient_light_energy = 0.12
reflected_light_source = 2
tonemap_mode = 4
; THE NIGHT EXPOSURE, and it is DECLARED rather than measured, because there is
; no reference frame for this station at range on the anti-sun side and saying
; otherwise would be the exact dishonesty CLAUDE.md's first hard rule is about.
; INV-036 says the same of the windows themselves: "No frame in the reference
; set shows the hull lit from within at range."
;
; WHY AN EXPOSURE AND NOT MORE EMISSION. Most of what is in a night frame is
; EMISSION -- the window sheet -- and no light energy scales emission, so
; `--light-gain` cannot expose a night side: at the arrival distance a
; `--light-gain 0.0` render leaves the drum 99.4% below the measurable floor
; with a p50 of 0.0017, i.e. turning every light in the scene off changes
; almost nothing. The only knob that moves emission is the camera's, which is
; this one. Raising `emission_energy` instead would change INV-036's physical
; claim about the windows in order to fix a photographic one.
;
; WHAT CONSTRAINS IT. Four things, all in tools/export_scene.EXTERIOR_CALIBRATION
; and all gated: the sheet's own mean emission (0.0193 linear over the texture
; at emission_energy 3.4, so 0.066 at any range where the apertures do not
; resolve -- and at 9.2 km they do not, 5.5 m a pixel against a 1.10 m
; aperture); the habitat-to-unlit-structure ratio, which must beat daylight's
; by a stop; the station's silhouette against the starfield; and clipping,
; which must stay under half a percent of the hull. 3.6 is 8.4x the day
; exposure, i.e. three and a bit stops -- conservative for the difference
; between a sunlit surface and a lit window.
tonemap_exposure = 3.6
tonemap_white = 6.0
; SSAO OFF, and it is measured rather than assumed. Rendering this shot with it
; ON produced a BYTE-IDENTICAL PNG -- max channel delta 0 over 960x540 -- and
; took 12s against 9s. It modulates ambient occlusion, and the night ambient is
; a 0.12 planetshine floor, so there is nothing here for it to occlude. A third
; of the frame time for no pixels.
;
; The sun's SHADOWS are a different answer to the same kind of question and are
; deliberately left ON: see tools/export_scene.EXTERIOR_CALIBRATION
; ["measured_and_unchanged"]. Turning them off changes 10% of this frame,
; because a grazing crescent is all shadow, and saves no measurable time.
ssao_enabled = false
glow_enabled = true
glow_normalized = true
glow_intensity = 0.55
glow_strength = 1.0
glow_bloom = 0.03
glow_blend_mode = 1
; Lower than the day's 1.1 because at night the windows ARE the subject and
; they sit far below the day threshold -- nothing in a night frame blooms at
; 1.1, so the one thing a camera does to a city at night was not happening.
; Set between the unlit hull and the lit band so the bands bloom and the plate
; does not.
glow_hdr_threshold = 0.60

[node name="ExteriorShot" type="Node3D"]
script = ExtResource("1")
fallback_material = ExtResource("m_hull")
warmup_frames = 8
night_environment = SubResource("EnvNight")
; WHICH LIGHTS GO DARK on the anti-sun side, and the sun is deliberately not
; among them. The sun does not switch off at night; the camera moves to the
; other side of it. Leaving it on at full energy is what produces the
; terminator and puts a real, correctly-placed edge on the limb.
;
; The rim has to go, and it is the whole reason this list exists. It is aimed
; from `sun_az + 175`, so at the arrival framing the three lights sit at 136,
; 49 and 116 degrees off the camera axis: the SUN is the backlight and the RIM
; is a three-quarter frontal key on the hemisphere this condition exists to
; show dark. The fill goes with it -- mirrored through the camera axis, it does
; the same job from the other side.
;
; MEASURED, not assumed. Rendered with both left burning, the habitat's median
; is 5.2x brighter (0.0112 -> 0.0586) and the station's visible footprint goes
; from 67% to 88%: a dim day side, not a night side.
night_lights_off = PackedStringArray("Fill", "Rim")
material_rules = {
"aft_hull_block": ExtResource("m_habitat_windows"),
"bay_lip": ExtResource("m_hazard_chevron"),
"cargo_module": ExtResource("m_cargo"),
"cobra_bay": ExtResource("m_bay_frame"),
"cobra_bay_well": ExtResource("m_bay_well"),
"cobra_beacon_red": ExtResource("m_hazlight"),
"cobra_marker_white": ExtResource("m_navlight"),
"comms_grid_pylon": ExtResource("m_truss"),
"docking_port": ExtResource("m_dome_glazing"),
"docking_port_frame": ExtResource("m_dome_structure"),
"explosive_disconnect_neck": ExtResource("m_truss"),
"forward_comms_plate": ExtResource("m_panel"),
"forward_swept_array": ExtResource("m_panel"),
"greeble_antenna": ExtResource("m_greeble_fitting"),
"greeble_blister": ExtResource("m_greeble_fitting"),
"greeble_cleat": ExtResource("m_greeble_fitting"),
"greeble_conduit": ExtResource("m_greeble_fitting"),
"greeble_hatch": ExtResource("m_greeble_fitting"),
"greeble_hazard_light": ExtResource("m_hazlight"),
"greeble_nav_light": ExtResource("m_navlight"),
"greeble_panel": ExtResource("m_greeble_fitting"),
"greeble_vent": ExtResource("m_greeble_fitting"),
"green_section": ExtResource("m_habitat_windows"),
"habitat_cylinder": ExtResource("m_habitat_windows"),
"hazard_stripe": ExtResource("m_hazard_chevron"),
"heat_exchange_solar_array": ExtResource("m_panel"),
"main_truss_spine": ExtResource("m_truss"),
"observation_dome": ExtResource("m_dome_glazing"),
"observation_dome_frame": ExtResource("m_dome_structure"),
"observation_rotunda": ExtResource("m_habitat_windows"),
"observation_rotunda_frame": ExtResource("m_dome_structure"),
"reactor_cooling_fin": ExtResource("m_rad"),
"reactor_spine": ExtResource("m_truss"),
"red_section": ExtResource("m_habitat_windows"),
"space_traffic_prox_array": ExtResource("m_panel")
}

[node name="Camera3D" type="Camera3D" parent="."]
fov = 46.0

[node name="Sun" type="DirectionalLight3D" parent="."]
light_energy = 3.6
light_color = Color(1, 0.955, 0.9, 1)
light_specular = 0.9
shadow_enabled = true
; Four PSSM splits over 12 km. One orthogonal map across an 8 km station is
; 2 m per texel at 4096 and the greebles -- 15 to 50 m fittings -- shadow as
; mush. Splits put the near quarter at sub-metre resolution, which is where
; the camera is.
directional_shadow_mode = 2
directional_shadow_split_1 = 0.04
directional_shadow_split_2 = 0.12
directional_shadow_split_3 = 0.34
directional_shadow_blend_splits = true
; Range is overridden per shot by render_shot.gd -- see there for why.
directional_shadow_max_distance = 12000.0
shadow_bias = 0.02
shadow_normal_bias = 0.6

[node name="Fill" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.7, 0.2, -0.68, 0, 0.96, 0.28, 0.71, 0.2, -0.67, 0, 0, 0)
light_energy = 0.16
light_color = Color(0.5, 0.63, 1, 1)
light_specular = 0.2
shadow_enabled = false

[node name="Rim" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.64, -0.28, 0.72, 0, 0.93, 0.36, -0.77, -0.23, 0.6, 0, 0, 0)
light_energy = 0.34
light_color = Color(0.82, 0.86, 1, 1)
light_specular = 1.0
shadow_enabled = false

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")
