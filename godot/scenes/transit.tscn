[gd_scene load_steps=2 format=3]

; THE MOVING BUILD. Same shape as scenes/walk.tscn and for the same reason:
; geometry is loaded at RUNTIME from the .glb files station/transit_runtime.py
; writes, so this scene cannot go stale against regenerated meshes and no
; binary enters the project. Everything -- which shaft, which landings, how long
; the ride takes -- arrives in the manifest that build writes; nothing about the
; station is described here.

[ext_resource type="Script" path="res://scripts/transit.gd" id="1_transit"]

[node name="Transit" type="Node3D"]
script = ExtResource("1_transit")
