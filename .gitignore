# Generated geometry is reproducible from the schema -- regenerate with
# station/generate_hull.py rather than committing multi-megabyte meshes.
station/generated/*.obj
station/generated/*.glb
station/generated/*.glb
station/generated/hull_lod*.obj
godot/station.glb
godot/.godot/
renders/
station/generated/corridor.obj
station/__pycache__/
station/generated/interior_*.obj
station/generated/starfury.obj
godot/scripts/*.uid

# Per-shot scene assembly (tools/export_scene.py). Same argument as above --
# 44 MB of .glb regenerated from the schema on demand. Needs its own line
# because a gitignore "*" does not cross a directory separator, so the
# station/generated/*.glb rule above does not reach this subdirectory.
station/generated/scene/
tools/__pycache__/
